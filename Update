-- === DRAG ===
local dragging, dragStart, startPos = false, nil, nil

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

Header.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- === LOGIQUE ===
local function updateToggle()
	if holding then
		ToggleBtn.Text = "ACTIVÉ"
		ToggleBtn.TextColor3 = Color3.fromRGB(255, 220, 220)
		ToggleBtn.BackgroundColor3 = C.On
		ToggleStroke.Transparency = 0.12
		ToggleStroke.Color = C.Accent
	else
		ToggleBtn.Text = "DÉSACTIVÉ"
		ToggleBtn.TextColor3 = C.TextDim
		ToggleBtn.BackgroundColor3 = C.Off
		ToggleStroke.Transparency = 0.4
		ToggleStroke.Color = C.AccentSoft
	end
end

local function startLoop()
	pcall(function() mouse2press() end)
	pcall(function() mouse1press() end)

	while holding do
		local delay = 0.045 + math.random() * 0.025

		pcall(function()
			if keyclick then keyclick(VK_E) end
		end)
		pcall(function()
			keypress(VK_E)
			task.wait(0.012 + math.random() * 0.01)
			keyrelease(VK_E)
		end)
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
			task.wait(0.008 + math.random() * 0.008)
			vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)

		task.wait(delay)
	end
end

local function stopLoop()
	holding = false
	pcall(function() keyrelease(VK_E) end)
	pcall(function() mouse2release() end)
	pcall(function() mouse1release() end)
end

local function toggle()
	if holding then
		stopLoop()
	else
		holding = true
		task.spawn(startLoop)
	end
	updateToggle()
end

-- === BOUTONS (Activated = mieux pour mobile) ===
CloseBtn.Activated:Connect(function()
	stopLoop()
	ScreenGui:Destroy()
end)

MinBtn.Activated:Connect(function()
	minimized = not minimized
	if minimized then
		TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {
			Size = UDim2.new(0, 280, 0, 50)
		}):Play()
		Content.Visible = false
	else
		Content.Visible = true
		TweenService:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {
			Size = UDim2.new(0, 280, 0, 165)
		}):Play()
	end
end)

ToggleBtn.Activated:Connect(toggle)

KeyBtn.Activated:Connect(function()
	changingKey = true
	KeyBtn.Text = "Appuie sur une touche..."
	KeyBtn.TextColor3 = Color3.fromRGB(255, 195, 130)
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end

	if changingKey and input.UserInputType == Enum.UserInputType.Keyboard then
		toggleKey = input.KeyCode
		changingKey = false
		KeyBtn.Text = "Touche : " .. input.KeyCode.Name
		KeyBtn.TextColor3 = C.TextDim
		return
	end

	if input.KeyCode == toggleKey then
		toggle()
	end
end)

updateToggle()
print("NIEHMU Mobile Fix chargé")
